{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suplemento.substack.com/formato/edicao.schema.json",
  "title": "Edição do Suplemento",
  "description": "Uma edição semanal do Suplemento. Fonte única: o app lê este arquivo e o HTML do Substack é gerado a partir dele. Formato 1.0, de 22/11/2026; formato 1.1, de 24/11/2026, organiza a edição em tópicos (de 1 a 3 textos cada).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formato",
    "numero",
    "data",
    "titulo",
    "abertura",
    "secoes",
    "verbetes",
    "destaques_por_dia"
  ],
  "properties": {
    "formato": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "1.1: a edição se organiza em tópicos (campo topicos)."
    },
    "numero": {
      "type": "integer",
      "minimum": 1
    },
    "data": {
      "$ref": "#/$defs/data",
      "description": "Data de publicação (quarta-feira)."
    },
    "titulo": {
      "type": "string",
      "description": "Sem o 'Nº N ·', que o app e o Substack acrescentam."
    },
    "subtitulo": {
      "type": "string"
    },
    "url_substack": {
      "type": "string",
      "format": "uri"
    },
    "abertura": {
      "$ref": "#/$defs/texto",
      "description": "3 a 5 linhas, voz da redação."
    },
    "secoes": {
      "type": "array",
      "description": "Ordem em que as seções aparecem na edição.",
      "items": {
        "$ref": "#/$defs/secao"
      },
      "minItems": 1
    },
    "topicos": {
      "type": "array",
      "description": "Formato 1.1. Os tópicos na ordem da edição: até 14, distribuídos pelas 5 seções (Repare, Para ler já, Livros, A contrapelo, Para ler com calma); a Estante acadêmica também usa um tópico, fora da conta. Cada um reúne de 1 a 3 verbetes: o primeiro é o principal, os outros entram como 'E também'.",
      "items": {
        "$ref": "#/$defs/topico"
      },
      "minItems": 1
    },
    "verbetes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verbete"
      },
      "minItems": 1
    },
    "lancamentos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item_com_link"
      }
    },
    "prazos": {
      "type": "array",
      "description": "Bloco curto de prazos da edição. O mural completo tem arquivo próprio.",
      "items": {
        "$ref": "#/$defs/prazo"
      }
    },
    "notas": {
      "type": "array",
      "description": "Notas da semana, 4 a 8.",
      "items": {
        "$ref": "#/$defs/nota"
      }
    },
    "destaques_por_dia": {
      "type": "object",
      "description": "Home do app: para cada dia (quarta a terça), até 5 ids, na ordem de exibição. No formato 1.1, ids de tópico (n3-t01); no 1.0, ids de verbete.",
      "propertyNames": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "maxItems": 5,
        "uniqueItems": true
      },
      "minProperties": 7,
      "maxProperties": 7
    }
  },
  "$defs": {
    "data": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "texto": {
      "type": "string",
      "description": "Markdown restrito: **negrito** (só nomes de pessoas centrais), *itálico* (veículos, obras, palavras estrangeiras) e [links](url). Sem sublinhado, sem títulos, sem listas."
    },
    "acesso_suplemento": {
      "enum": [
        "aberto",
        "assinantes"
      ],
      "description": "Quem vê no Substack. No app, assinante vê tudo."
    },
    "secao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nome",
        "acesso"
      ],
      "properties": {
        "id": {
          "enum": [
            "repare",
            "para-ler-ja",
            "livros",
            "a-contrapelo",
            "achados",
            "para-ler-com-calma",
            "estante-academica",
            "lancamentos-e-prazos",
            "notas"
          ]
        },
        "nome": {
          "type": "string"
        },
        "linha_do_fio": {
          "type": "string",
          "description": "Linha opcional em itálico abaixo do nome (usada em A contrapelo)."
        },
        "acesso": {
          "$ref": "#/$defs/acesso_suplemento"
        }
      }
    },
    "verbete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "secao",
        "veiculo",
        "url",
        "lingua",
        "acesso_fonte",
        "regiao"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^n\\d+-\\d{2}$",
          "description": "Ex.: n2-01. Fixo depois de publicado."
        },
        "secao": {
          "type": "string",
          "description": "id de uma das seções da edição."
        },
        "citacao": {
          "type": "string",
          "description": "Em português, sem aspas (o app e o HTML põem as aspas)."
        },
        "conferencia": {
          "type": "string",
          "description": "Trecho original da citação. Uso interno: não aparece no app nem no Substack."
        },
        "resumo": {
          "$ref": "#/$defs/texto"
        },
        "autor": {
          "type": "string",
          "description": "Autor do texto, como no registro ('—' se não houver)."
        },
        "figura": {
          "type": "string",
          "description": "Figura ou tema central, para busca e registro."
        },
        "veiculo": {
          "type": "string"
        },
        "veiculo_complemento": {
          "type": "string",
          "description": "Afiliação da revista acadêmica ou tradutor: 'UFMG', 'tradução de Pedro Silva'."
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "lingua": {
          "enum": [
            "pt",
            "en",
            "es",
            "fr",
            "it",
            "de"
          ]
        },
        "lingua_original": {
          "type": "string",
          "description": "Quando o texto é versão de um original em outra língua: 'árabe'."
        },
        "acesso_fonte": {
          "enum": [
            "aberto",
            "parcial",
            "paywall"
          ],
          "description": "Acesso ao texto original, não ao Suplemento."
        },
        "nota_acesso": {
          "type": "string",
          "description": "Ex.: 'dois textos grátis por mês'."
        },
        "area": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regiao": {
          "enum": [
            "Brasil",
            "América Latina",
            "Caribe",
            "Áfricas",
            "Oriente Médio e mundo árabe",
            "Ásia",
            "Europa Ocidental",
            "Europa (margens)",
            "América do Norte",
            "Global"
          ]
        },
        "regiao_obs": {
          "type": "string",
          "description": "Parêntese do registro: 'veículo dos EUA'."
        },
        "na_mesma_semana": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "texto",
            "url",
            "veiculo",
            "lingua"
          ],
          "properties": {
            "texto": {
              "$ref": "#/$defs/texto"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "veiculo": {
              "type": "string"
            },
            "regiao": {
              "type": "string"
            },
            "lingua": {
              "enum": [
                "pt",
                "en",
                "es",
                "fr",
                "it",
                "de"
              ]
            }
          },
          "description": "Formato 1.0: complemento do Repare. No 1.1, use um verbete 'tambem' no tópico."
        },
        "assinatura": {
          "type": "string",
          "description": "Como a autoria aparece para o leitor, quando o campo autor não basta (entrevistas): 'Georges Didi-Huberman, em conversa com Sara Cohen'. Sem ela, o app mostra o autor."
        },
        "papel": {
          "enum": [
            "principal",
            "tambem"
          ],
          "description": "Formato 1.1. 'tambem': texto secundário do tópico, numa linha, sem citação nem resumo longo. Sem o campo, vale 'principal'."
        },
        "linha": {
          "$ref": "#/$defs/texto",
          "description": "Formato 1.1, para papel 'tambem': uma linha (até 25 palavras) dizendo o que é e por que ler."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "papel": {
                "const": "tambem"
              }
            },
            "required": [
              "papel"
            ]
          },
          "then": {
            "required": [
              "linha"
            ]
          },
          "else": {
            "required": [
              "citacao",
              "resumo"
            ]
          }
        }
      ]
    },
    "item_com_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texto"
      ],
      "properties": {
        "texto": {
          "$ref": "#/$defs/texto"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "rotulo_link": {
          "type": "string",
          "description": "Texto do link no fim da linha: 'ler', 'edital', 'chamada', o nome do site."
        }
      }
    },
    "prazo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nome",
        "promotor",
        "prazo",
        "url"
      ],
      "properties": {
        "nome": {
          "type": "string",
          "description": "O que é a chamada, depois do promotor."
        },
        "promotor": {
          "type": "string",
          "description": "Quem promove, como aparece na linha (pode ter itálico, se for revista)."
        },
        "publico": {
          "type": "string"
        },
        "prazo": {
          "oneOf": [
            {
              "$ref": "#/$defs/data"
            },
            {
              "const": "fluxo contínuo"
            }
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "rotulo_link": {
          "type": "string",
          "description": "Texto do link no fim da linha: 'ler', 'edital', 'chamada', o nome do site."
        },
        "nova_na_semana": {
          "type": "boolean",
          "description": "Chamada que entrou nesta semana (vai sob 'Novas na semana')."
        }
      }
    },
    "nota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "titulo",
        "texto",
        "url"
      ],
      "properties": {
        "texto": {
          "$ref": "#/$defs/texto"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "data_fato": {
          "$ref": "#/$defs/data",
          "description": "Só quando o fato for anterior à semana."
        },
        "titulo": {
          "$ref": "#/$defs/texto",
          "description": "Abertura em negrito da nota: 'Goncourt com IA.', 'Chile.'."
        },
        "rotulo_link": {
          "type": "string",
          "description": "Texto do link no fim da linha: 'ler', 'edital', 'chamada', o nome do site."
        }
      }
    },
    "topico": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "secao",
        "titulo",
        "verbetes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^n\\d+-t\\d{2}$",
          "description": "Ex.: n3-t01. Fixo depois de publicado."
        },
        "secao": {
          "type": "string",
          "description": "id de uma das seções da edição; os verbetes do tópico ficam na mesma seção."
        },
        "titulo": {
          "type": "string",
          "description": "Nome do tópico, da redação, de 2 a 6 palavras: 'A crítica, para quê'."
        },
        "verbetes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "ids dos verbetes; o primeiro é o principal."
        }
      }
    }
  }
}
